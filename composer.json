{
    "name": "jmf/route-access-bundle",
    "description": "Route access Symfony bundle",
    "license": "mit",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.3",
        "symfony/cache": "^7.0|^8.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/security-core": "^7.0|^8.0",
        "twig/twig": "^3.0",
        "webmozart/assert": "^1.12|^2.0"
    },
    "require-dev": {
        "overtrue/phplint": "^9",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^12|^13",
        "rector/rector": "^2",
        "squizlabs/php_codesniffer": "^4"
    },
    "config": {
        "audit": {
            "abandoned": "report"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\RouteAccess\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\RouteAccess\\Tests\\": "tests/src"
        }
    }
}
